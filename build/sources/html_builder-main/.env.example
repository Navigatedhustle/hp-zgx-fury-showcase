# Copy to .env and adjust. All settings are optional; defaults shown.
# These names are the contract: backend/app/config.py reads each one into the field of the same name.

# --- Authoring model: plan, generate, repair, revise (GB300 over Tailscale) ---
# On the ZRT gateway every model sits behind one URL and is picked by the label it was served with
# (`zrt serve unsloth/Qwen3.6-27B-NVFP4 --label qwen`), so LLM_MODEL is that label.
LLM_BASE_URL=http://gb300:8080/v1
LLM_API_KEY=none
LLM_MODEL=qwen

# --- Review model: critic, pairwise A/B, eval judge, grounding ---
# Each field falls back to its LLM_* counterpart when empty, so leaving all three blank keeps the
# single-model setup exactly as it was. Set VLM_MODEL to split the roles: a different model family
# removes the self-preference bias of a model grading its own output, and two models means the
# authoring prefix and the review prefix stop evicting each other from one KV cache. On ZRT only
# VLM_MODEL is needed (the label, e.g. gemma); VLM_BASE_URL is for a model on a different server.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=gemma

# --- Embedding model: ranks reference-document passages by meaning (optional) ---
# Empty EMBED_MODEL = off: passages are ranked by shared words only and nothing else changes. On ZRT set it
# to the label the model was served with (e.g. `zrt serve ironbcc/Qwen3-Embedding-4B-NVFP4 --label embed`);
# it must be served as an embedding model (vLLM: --runner pooling --convert embed, see deploy/gb300/serve_embed.sh).
# EMBED_BASE_URL / EMBED_API_KEY fall back to LLM_*. EMBED_DIM keeps the first N dimensions — only for a
# Matryoshka-trained model such as Qwen3-Embedding (1024 is a good value there); 0 keeps them all.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=embed
EMBED_DIM=1024

# auto = probe the model with a tiny image once; on | off to force. Anything else is refused at startup.
VISION=auto

# Offline mode: template slides, no GB300 calls (demo / UI work)
LLM_MOCK=false

# --- Throughput ---
LLM_MAX_CONCURRENCY=8
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_S=600
# Constrain the JSON-only stages (plan, critic, pairwise A/B, eval judge) with vLLM's guided_json.
# Never used for slide generation. Turns itself off for the process if the server refuses it.
GUIDED_JSON=true

# --- Per-stage model knobs ---
# Qwen3 thinking mode per stage (plan benefits; generation is faster without)
THINKING_PLAN=true
THINKING_GENERATE=false
THINKING_CRITIC=false
# Sampling temperature: A is the cinematic variant, B the refined one, repair the fix-up pass.
TEMP_A=0.8
TEMP_B=0.5
TEMP_REPAIR=0.3

# --- Quality loop ---
QA_MAX_REPAIRS=2
QA_CONCURRENCY=3
CRITIC_MIN_SCORE=7
# Variant-A drafts to sample and filter by DOM check before QA. 1 = off; each extra draft costs one
# generation and one render per slide.
GENERATE_BEST_OF_A=1

# --- Local ---
# auto | powerpoint | libreoffice | none. Anything else is refused at startup.
RENDERER=auto
DATA_DIR=data
PORT=8765

# --- Obsidian (optional) ---
# A folder that is (or will become) an Obsidian vault. "Sync to Obsidian vault" in the Library writes the
# slide library into <vault>/HP Slide Library/ only, and never touches a note it did not write. Empty = off;
# the Library can still download the same vault as a .zip ("Open folder as vault" in Obsidian).
OBSIDIAN_VAULT_DIR=
